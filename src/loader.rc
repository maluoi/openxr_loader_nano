// Windows DLL version resource, matching what upstream's loader reports.
// CMake defines XRL_NAME, XRL_VERSION_MAJOR, XRL_VERSION_MINOR and XRL_VERSION_PATCH.

#ifdef __MINGW32__
#include "winresrc.h"
#else
#include "winres.h"
#endif

#define XRL_STRINGIZE2(s) #s
#define XRL_STRINGIZE(s) XRL_STRINGIZE2(s)
#define XRL_VERSION     XRL_VERSION_MAJOR, XRL_VERSION_MINOR, XRL_VERSION_PATCH, 0
#define XRL_VERSION_STR XRL_STRINGIZE(XRL_VERSION_MAJOR) "." XRL_STRINGIZE(XRL_VERSION_MINOR) "." XRL_STRINGIZE(XRL_VERSION_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    XRL_VERSION
 PRODUCTVERSION XRL_VERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x00000L
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "04090000"
		BEGIN
			VALUE "FileDescription", "OpenXR Loader"
			VALUE "FileVersion",     XRL_VERSION_STR
			VALUE "ProductName",     "OpenXR Loader (" XRL_STRINGIZE(XRL_NAME) ")"
			VALUE "ProductVersion",  XRL_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 0000
	END
END
